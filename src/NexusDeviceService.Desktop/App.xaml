<Application x:Class="NexusDeviceService.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NexusDeviceService.Desktop">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Active Theme: Swapped dynamically at runtime by IThemeService -->
                <ResourceDictionary Source="Styles/Themes/Theme.Dark.xaml" />

                <!-- Foundation Tokens & Vector Geometries -->
                <ResourceDictionary Source="Styles/Dimensions.xaml" />
                <ResourceDictionary Source="Styles/Typography.xaml" />
                <ResourceDictionary Source="Styles/VectorIcons.xaml" />

                <!-- Control Styles -->
                <ResourceDictionary Source="Styles/Controls/Buttons.xaml" />
                <ResourceDictionary Source="Styles/Controls/Inputs.xaml" />
                <ResourceDictionary Source="Styles/Controls/Cards.xaml" />
                <ResourceDictionary Source="Styles/Controls/Badges.xaml" />
                <ResourceDictionary Source="Styles/Controls/Progress.xaml" />
                <ResourceDictionary Source="Styles/Controls/DataGrids.xaml" />
                <ResourceDictionary Source="Styles/Controls/Tooltips.xaml" />
                <ResourceDictionary Source="Styles/Controls/Navigation.xaml" />
                <ResourceDictionary Source="Styles/Controls/Dialogs.xaml" />

                <!-- ViewModel to View Mappings -->
                <ResourceDictionary Source="Views/ViewMappings.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
