<UserControl x:Class="NexusDeviceService.Desktop.Views.Pages.OperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NexusDeviceService.Desktop.ViewModels.Pages"
             xmlns:ctrl="clr-namespace:NexusDeviceService.Desktop.Controls"
             xmlns:conv="clr-namespace:NexusDeviceService.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OperationsViewModel}">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="1040">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Operation Center &amp; Service Lifecycle" Style="{StaticResource TextHeader}"/>
                    <TextBlock Text="{Binding GateNotice}" Style="{StaticResource TextCaption}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Verify Pre-Flight Gating"
                        Command="{Binding InspectCapabilitiesCommand}"
                        Style="{StaticResource ButtonSecondary}" />
            </Grid>

            <!-- Device Selector Bar -->
            <Border Style="{StaticResource CardStandard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="TARGET DEVICE:"
                               Style="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               Foreground="{DynamicResource BrushTextMuted}" />

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DiscoveredDevices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource InputComboBox}" />
                </Grid>
            </Border>

            <!-- Operations Catalog -->
            <Border Style="{StaticResource CardStandard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="AVAILABLE SERVICE OPERATIONS (GATED BY CAPABILITY)"
                               Style="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMuted}"
                               Margin="0,0,0,12"/>

                    <DataGrid ItemsSource="{Binding AvailableOperations}"
                              SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                              Height="170">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="OPERATION ID" Binding="{Binding Descriptor.OperationId}" Width="160" />
                            <DataGridTextColumn Header="OPERATION NAME" Binding="{Binding Descriptor.DisplayName}" Width="250" />
                            <DataGridTextColumn Header="RISK CLASSIFICATION" Binding="{Binding Descriptor.Risk}" Width="150" />
                            <DataGridTextColumn Header="REQUIRED CAPABILITY" Binding="{Binding Descriptor.RequiredCapabilities}" Width="180" />
                            <DataGridTextColumn Header="CONFIRMATION" Binding="{Binding Descriptor.RequiresUserConfirmation}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Active Execution Panel -->
            <Border Style="{StaticResource CardElevated}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="OPERATION EXECUTION CONTROLLER"
                                       Style="{StaticResource TextCaption}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushAccent}" />
                            <TextBlock Text="{Binding SelectedOperation.Descriptor.DisplayName, FallbackValue='No Operation Selected'}"
                                       Style="{StaticResource TextSubheader}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- State Badge -->
                        <Border Grid.Column="1"
                                Style="{StaticResource BadgeStandard}"
                                Background="{DynamicResource BrushSurfaceAlt}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding LifecycleState}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}" />
                        </Border>
                    </Grid>

                    <!-- Confirmation Notice if required -->
                    <Border Background="#2A2000"
                            BorderBrush="#FFB020"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConfirmationRequired}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <CheckBox Content="I confirm this operation adheres to safety protocols and understand its impact."
                                  IsChecked="{Binding UserConfirmed, Mode=TwoWay}"
                                  Foreground="#FFD580"
                                  FontWeight="SemiBold" />
                    </Border>

                    <!-- Error Banner -->
                    <Border Background="#331A1A"
                            BorderBrush="{DynamicResource BrushStatusError}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastErrorMessage, Converter={x:Null}}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding LastErrorMessage}"
                                   Foreground="{DynamicResource BrushStatusError}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Progress Bar -->
                    <ProgressBar Height="8"
                                 Value="{Binding ProgressPercentage}"
                                 Minimum="0"
                                 Maximum="100"
                                 Style="{StaticResource ProgressTrack}"
                                 Margin="0,0,0,10" />

                    <!-- Status Description -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource TextBody}"
                                   Foreground="{DynamicResource BrushTextMuted}" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProgressPercentage, StringFormat='{}{0:0}%'}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                    </Grid>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Execute Operation"
                                Command="{Binding ExecuteOperationCommand}"
                                Style="{StaticResource ButtonPrimary}"
                                Margin="0,0,12,0" />

                        <Button Content="Cancel"
                                Command="{Binding CancelActiveOperationCommand}"
                                IsEnabled="{Binding CanCancel}"
                                Style="{StaticResource ButtonDestructive}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Execution Result / Diagnostic Logs -->
            <Border Style="{StaticResource CardStandard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="LATEST EXECUTION AUDIT LOGS"
                               Style="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMuted}"
                               Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding LastReport.LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="{StaticResource FontMonospace}"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Authorized SIM Unlock Service Panel (Prompt 15) -->
            <Border Style="{StaticResource CardStandard}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="AUTHORIZED 3GPP SIM NETWORK PERSONALIZATION (CARRIER SERVICE)"
                                       Style="{StaticResource TextCaption}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextMuted}" />
                            <TextBlock Text="Phase-gated legitimate unlock workflow with server authorization, zero exploit bypasses, and baseband verification."
                                       Style="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Evaluate SIM Eligibility (Phase 1)"
                                Command="{Binding CheckSimEligibilityCommand}"
                                Style="{StaticResource ButtonSecondary}" />
                    </Grid>

                    <!-- Eligibility Display -->
                    <Border Background="{DynamicResource BrushBackgroundSurface}"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12"
                            Visibility="{Binding SimEligibility, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="LOCK STATUS: "
                                           FontWeight="Bold"
                                           Style="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource BrushTextMuted}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SimEligibility.LockStatus}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccentPrimary}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SimEligibility.RetriesRemaining, StringFormat='Retries: {0}'}"
                                           Style="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource BrushTextSecondary}" />
                            </Grid>

                            <TextBlock Text="{Binding SimEligibility.GuidanceMessage}"
                                       Style="{StaticResource TextCaption}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushTextPrimary}" />
                        </StackPanel>
                    </Border>

                    <!-- SIM Unlock Audit History (Phase 6) -->
                    <TextBlock Text="SIM UNLOCK AUDIT RECORDS (PHASE 6)"
                               Style="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMuted}"
                               Margin="0,4,0,8" />

                    <DataGrid ItemsSource="{Binding SimAuditRecords}"
                              Height="110"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AUDIT ID" Binding="{Binding AuditId}" Width="150" />
                            <DataGridTextColumn Header="DEVICE / MASKED IMEI" Binding="{Binding MaskedImei}" Width="180" />
                            <DataGridTextColumn Header="SUCCESS" Binding="{Binding IsSuccess}" Width="80" />
                            <DataGridTextColumn Header="MOCK AUTH" Binding="{Binding IsMockSuccess}" Width="90" />
                            <DataGridTextColumn Header="TIMESTAMP (UTC)" Binding="{Binding TimestampUtc, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150" />
                            <DataGridTextColumn Header="SUMMARY" Binding="{Binding Summary}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Historical Operations Table -->
            <Border Style="{StaticResource CardStandard}">
                <StackPanel>
                    <TextBlock Text="RECENT OPERATION AUDIT TRAIL"
                               Style="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMuted}"
                               Margin="0,0,0,12" />

                    <DataGrid ItemsSource="{Binding ExecutionHistory}"
                              Height="150"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="OPERATION ID" Binding="{Binding OperationId}" Width="160" />
                            <DataGridTextColumn Header="NAME" Binding="{Binding DisplayName}" Width="220" />
                            <DataGridTextColumn Header="DEVICE" Binding="{Binding TargetDeviceSerialOrPort}" Width="130" />
                            <DataGridTextColumn Header="OUTCOME" Binding="{Binding State}" Width="110" />
                            <DataGridTextColumn Header="DURATION" Binding="{Binding Duration}" Width="110" />
                            <DataGridTextColumn Header="STATUS" Binding="{Binding StatusText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
