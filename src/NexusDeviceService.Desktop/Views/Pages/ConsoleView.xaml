<UserControl x:Class="NexusDeviceService.Desktop.Views.Pages.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NexusDeviceService.Desktop.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConsoleViewModel}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Toolbar & Filters -->
            <RowDefinition Height="Auto" />
            <!-- Log Stream -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header & Action Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource CardStandard}" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeometryTerminal}"
                              Fill="{DynamicResource BrushAccent}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Structured Activity &amp; Diagnostics Console" Style="{StaticResource TextSectionTitle}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource BadgeNeutral}" Margin="12,0,0,0">
                            <TextBlock Text="{Binding FilteredLogEntries.Count, StringFormat='{}{0} Entries'}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Copy Logs"
                                Command="{Binding CopyLogsCommand}"
                                Style="{StaticResource ButtonSecondary}"
                                Margin="0,0,8,0" />
                        <Button Content="Export (Text)"
                                Command="{Binding ExportLogsCommand}"
                                CommandParameter="text"
                                Style="{StaticResource ButtonSecondary}"
                                Margin="0,0,8,0" />
                        <Button Content="Export (JSON)"
                                Command="{Binding ExportLogsCommand}"
                                CommandParameter="json"
                                Style="{StaticResource ButtonSecondary}"
                                Margin="0,0,8,0" />
                        <Button Content="Clear Visible"
                                Command="{Binding ClearConsoleCommand}"
                                Style="{StaticResource ButtonDestructive}" />
                    </StackPanel>
                </Grid>

                <!-- Search and Filter Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}"
                             Tag="Filter by message, category, or operation ID..."
                             Margin="0,0,12,0" />

                    <!-- Severity Filter -->
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableSeverities}"
                              SelectedItem="{Binding SelectedSeverity, Mode=TwoWay}"
                              Style="{StaticResource InputComboBox}" />
                </Grid>

                <!-- Feedback banner if any -->
                <TextBlock Text="{Binding ExportStatusMessage}"
                           Foreground="{DynamicResource BrushAccent}"
                           Margin="0,8,0,0"
                           FontWeight="SemiBold"
                           Visibility="{Binding ExportStatusMessage, Converter={x:Null}}" />
            </StackPanel>
        </Border>

        <!-- Monospace Log List -->
        <Border Grid.Row="1"
                Background="{DynamicResource BrushInputBackground}"
                BorderBrush="{DynamicResource BrushSurfaceBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="12">
            <ListBox ItemsSource="{Binding FilteredLogEntries}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <!-- Timestamp -->
                            <TextBlock Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss.fff}]'}"
                                       Style="{StaticResource TextMonospace}"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       Margin="0,0,8,0" />

                            <!-- Severity -->
                            <TextBlock Text="{Binding Level, StringFormat='[{0,-11}]'}"
                                       Style="{StaticResource TextMonospace}"
                                       Foreground="{DynamicResource BrushAccent}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0" />

                            <!-- Correlation/Op ID pill if present -->
                            <Border Background="#1C2836"
                                    CornerRadius="3"
                                    Padding="4,1"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding CorrelationId, Converter={x:Null}}">
                                <TextBlock Text="{Binding CorrelationId, StringFormat='CID:{0}'}"
                                           Style="{StaticResource TextMonospace}"
                                           FontSize="11"
                                           Foreground="#60A5FA" />
                            </Border>

                            <!-- Category -->
                            <TextBlock Text="{Binding Category, StringFormat='({0})'}"
                                       Style="{StaticResource TextMonospace}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,0,8,0" />

                            <!-- Message -->
                            <TextBlock Text="{Binding Message}"
                                       Style="{StaticResource TextMonospace}"
                                       Foreground="{DynamicResource BrushTextPrimary}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
