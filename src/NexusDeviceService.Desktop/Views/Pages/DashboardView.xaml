<UserControl x:Class="NexusDeviceService.Desktop.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NexusDeviceService.Desktop.ViewModels.Pages"
             xmlns:ctrl="clr-namespace:NexusDeviceService.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <!-- Row 0: Welcome / Header Section -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Loading Progress & Error Banner -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Simulation Mode Warning / Info Banner -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Connection Summary Cards (4 Metrics) -->
                <RowDefinition Height="Auto" />
                <!-- Row 4: Quick Actions Bar -->
                <RowDefinition Height="Auto" />
                <!-- Row 5: Responsive Split Content (Left: Operations & Modules, Right: Activity & Status) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Welcome / Title Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource TextHeader}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding HostInfo, StringFormat='Workstation Host: {0}'}"
                                   Style="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <TextBlock Text=" • "
                                   Style="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource BrushTextMuted}" />
                        <TextBlock Text="{Binding QuickStatus}"
                                   Style="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource BrushAccent}" />
                    </StackPanel>
                </StackPanel>

                <!-- Refresh Hub Action -->
                <Button Grid.Column="1"
                        Command="{Binding RefreshDashboardCommand}"
                        Style="{StaticResource ButtonSecondary}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeometryRefresh}"
                              Fill="{DynamicResource BrushTextPrimary}"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh Hub" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Row 1: Loading Progress Bar & Error Banner -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <!-- Loading Progress Bar -->
                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Height="4"
                             Margin="0,0,0,8" />

                <!-- Error Banner -->
                <Border Background="{DynamicResource BrushStatusErrorBg}"
                        BorderBrush="{DynamicResource BrushStatusError}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="14,10"
                        Margin="0,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeometryAlertCircle}"
                              Fill="{DynamicResource BrushStatusError}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#FFFFFF"
                                   Style="{StaticResource TextBodyStrong}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Row 2: Visible Simulation Mode Notice Banner -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushStatusSimulationBg}"
                    BorderBrush="{DynamicResource BrushStatusSimulation}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="14,10"
                    Margin="0,0,0,16"
                    Visibility="{Binding IsDemonstrationData, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Data="{StaticResource GeometryAlertTriangle}"
                          Fill="{DynamicResource BrushStatusSimulation}"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="DEMONSTRATION &amp; SIMULATION TIER ACTIVE"
                                   Foreground="{DynamicResource BrushStatusSimulation}"
                                   FontWeight="Bold"
                                   FontSize="{StaticResource FontSizeCaption}" />
                        <TextBlock Text="Connected channels and operational telemetry are generated by virtual device providers. Physical hardware bus probes and real flashing are disabled in this mode."
                                   Style="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Style="{StaticResource BadgeSimulation}"
                            VerticalAlignment="Center">
                        <TextBlock Text="SAFE LAB ENVIRONMENT" FontSize="9"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Row 3: Connection Summary Cards (UniformGrid for Responsive Sizing) -->
            <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,16">
                <!-- Summary Card 1: Connected Hardware -->
                <ctrl:SummaryCard Title="CONNECTED HARDWARE"
                                  Value="{Binding DeviceSummary.TotalConnectedCount, TargetNullValue='0'}"
                                  Subtext="{Binding DeviceSummary.PrimaryDeviceDisplayName, TargetNullValue='No Hardware Attached'}"
                                  IconGeometry="{StaticResource GeometryUsb}"
                                  IconBrush="{DynamicResource BrushAccent}"
                                  ValueBrush="{DynamicResource BrushAccent}"
                                  BadgeText="PHYSICAL"
                                  BadgeBrush="{DynamicResource BrushStatusSuccess}"
                                  BadgeBackground="{DynamicResource BrushStatusSuccessBg}"
                                  Margin="0,0,8,0" />

                <!-- Summary Card 2: Active Interface Port -->
                <ctrl:SummaryCard Title="COMMUNICATION CHANNELS"
                                  Value="{Binding DeviceSummary.ActiveInterfaceOrPort, TargetNullValue='None'}"
                                  Subtext="Hardware PnP Bus &amp; Endpoints"
                                  IconGeometry="{StaticResource GeometryTerminal}"
                                  IconBrush="{DynamicResource BrushStatusInfo}"
                                  ValueBrush="{DynamicResource BrushTextPrimary}"
                                  BadgeText="ONLINE"
                                  BadgeBrush="{DynamicResource BrushStatusSuccess}"
                                  BadgeBackground="{DynamicResource BrushStatusSuccessBg}"
                                  Margin="4,0,4,0" />

                <!-- Summary Card 3: Platform Health -->
                <ctrl:SummaryCard Title="PLATFORM ENGINE"
                                  Value="Optimal"
                                  Subtext="Physical Device Enumerator Active"
                                  IconGeometry="{StaticResource GeometryCheckCircle}"
                                  IconBrush="{DynamicResource BrushStatusSuccess}"
                                  ValueBrush="{DynamicResource BrushStatusSuccess}"
                                  BadgeText="READY"
                                  BadgeBrush="{DynamicResource BrushStatusSuccess}"
                                  BadgeBackground="{DynamicResource BrushStatusSuccessBg}"
                                  Margin="4,0,4,0" />

                <!-- Summary Card 4: Station Mode -->
                <ctrl:SummaryCard Title="STATION PROFILE"
                                  Value="Technician Station"
                                  Subtext="Local USB Diagnostics"
                                  IconGeometry="{StaticResource GeometryChip}"
                                  IconBrush="{DynamicResource BrushTextMuted}"
                                  ValueBrush="{DynamicResource BrushTextPrimary}"
                                  BadgeText="ONLINE"
                                  BadgeBrush="{DynamicResource BrushStatusSuccess}"
                                  BadgeBackground="{DynamicResource BrushStatusSuccessBg}"
                                  Margin="8,0,0,0" />
            </UniformGrid>

            <!-- Row 4: Quick Actions Bar -->
            <Border Grid.Row="4" Style="{StaticResource CardStandard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="QUICK ACTIONS &amp; WORKBENCH SHORTCUTS"
                                   Style="{StaticResource TextCaption}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Grid.Column="1"
                                   Text="Safe Navigation — No hardware actions initiated"
                                   Style="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource BrushTextMuted}"/>
                    </Grid>

                    <WrapPanel Grid.Row="1">
                        <!-- Quick Action 1: Scan Hardware -->
                        <Button Command="{Binding NavigateToCommand}" CommandParameter="devices"
                                Style="{StaticResource ButtonSecondary}" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeometryUsb}" Fill="{DynamicResource BrushAccent}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Scan Devices" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Quick Action 2: Operations Catalog -->
                        <Button Command="{Binding NavigateToCommand}" CommandParameter="operations"
                                Style="{StaticResource ButtonSecondary}" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeometryChip}" Fill="{DynamicResource BrushStatusInfo}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Operation Catalog" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Quick Action 3: Firmware Tool -->
                        <Button Command="{Binding NavigateToCommand}" CommandParameter="firmware"
                                Style="{StaticResource ButtonSecondary}" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeometryLock}" Fill="{DynamicResource BrushStatusWarning}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Verify Firmware" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Quick Action 4: Console Log -->
                        <Button Command="{Binding NavigateToCommand}" CommandParameter="console"
                                Style="{StaticResource ButtonSecondary}" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeometryTerminal}" Fill="{DynamicResource BrushTextPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Activity Console" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Quick Action 5: Station Settings -->
                        <Button Command="{Binding NavigateToCommand}" CommandParameter="settings"
                                Style="{StaticResource ButtonSecondary}" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeometrySettings}" Fill="{DynamicResource BrushTextMuted}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Station Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Row 5: Responsive Split Layout -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <!-- Left: Recent Operations & Protocol Modules -->
                    <ColumnDefinition Width="*" />
                    <!-- Right: Activity Feed, App Status & System Events -->
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <!-- Recent Operations Card -->
                    <Border Style="{StaticResource CardStandard}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RECENT SESSIONS &amp; OPERATIONS"
                                           Style="{StaticResource TextCaption}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextMuted}"/>
                                <Border Grid.Column="1" Style="{StaticResource BadgeNeutral}">
                                    <TextBlock Text="{Binding RecentOperations.Count, StringFormat='{}{0} LOGGED'}" FontSize="9"/>
                                </Border>
                            </Grid>

                            <!-- Operations DataGrid -->
                            <DataGrid ItemsSource="{Binding RecentOperations}"
                                      SelectedItem="{Binding SelectedOperation}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      MinHeight="140"
                                      MaxHeight="220"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      RowHeaderWidth="0">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNoOperations}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TIMESTAMP"
                                                        Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                                        Width="90" />
                                    <DataGridTextColumn Header="OPERATION"
                                                        Binding="{Binding OperationName}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="TARGET DEVICE"
                                                        Binding="{Binding TargetDevice}"
                                                        Width="160" />
                                    <DataGridTemplateColumn Header="STATUS" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource BadgeSuccess}">
                                                    <TextBlock Text="{Binding Status}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="DURATION"
                                                        Binding="{Binding DurationText}"
                                                        Width="80" />
                                    <DataGridTemplateColumn Header="TYPE" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource BadgeNeutral}">
                                                    <TextBlock Text="HARDWARE" FontSize="9"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Operations Empty State Component -->
                            <ctrl:StateView Title="No Operation History"
                                            Description="No device operations have been executed during the current technician session."
                                            IconGeometry="{StaticResource GeometryChip}"
                                            IconBrush="{DynamicResource BrushTextMuted}"
                                            ActionText="Open Operation Catalog"
                                            ActionCommand="{Binding NavigateToCommand}"
                                            ActionCommandParameter="operations">
                                <ctrl:StateView.Style>
                                    <Style TargetType="ctrl:StateView">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNoOperations}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ctrl:StateView.Style>
                            </ctrl:StateView>
                        </StackPanel>
                    </Border>

                    <!-- Available Device Modules Card -->
                    <Border Style="{StaticResource CardStandard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="AVAILABLE DEVICE PROTOCOL MODULES"
                                           Style="{StaticResource TextCaption}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextMuted}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AvailableModules.Count, StringFormat='{}{0} Modules Registered'}"
                                           Style="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource BrushAccent}"/>
                            </Grid>

                            <!-- Modules List -->
                            <ItemsControl ItemsSource="{Binding AvailableModules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushSurfaceElevated}"
                                                BorderBrush="{DynamicResource BrushSurfaceBorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusMedium}"
                                                Padding="12,8"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ModuleName}"
                                                                   Style="{StaticResource TextBodyStrong}"
                                                                   Margin="0,0,8,0"/>
                                                        <Border Style="{StaticResource BadgeNeutral}">
                                                            <TextBlock Text="{Binding Category}" FontSize="9"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}"
                                                               Style="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource BrushTextMuted}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource BadgeNeutral}" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding DriverVersion}" FontSize="9"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column -->
                <StackPanel Grid.Column="1">
                    <!-- Recent Activity Card -->
                    <Border Style="{StaticResource CardStandard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="PLATFORM ACTIVITY FEED"
                                       Style="{StaticResource TextCaption}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       Margin="0,0,0,10"/>

                            <!-- Activity Items -->
                            <ItemsControl ItemsSource="{Binding RecentActivities}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNoActivities}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BrushSurfaceBorderSubtle}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,6,0,8"
                                                Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Style="{StaticResource BadgeNeutral}"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                               FontSize="9"/>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Description}"
                                                               Style="{StaticResource TextCaption}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Category, StringFormat='Category: {0}'}"
                                                               Style="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource BrushTextMuted}"
                                                               FontSize="10"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Activities Empty State Component -->
                            <ctrl:StateView Title="No Recent Activity"
                                            Description="No telemetry events have occurred in this session."
                                            IconGeometry="{StaticResource GeometryTerminal}"
                                            IconBrush="{DynamicResource BrushTextMuted}">
                                <ctrl:StateView.Style>
                                    <Style TargetType="ctrl:StateView">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNoActivities}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ctrl:StateView.Style>
                            </ctrl:StateView>
                        </StackPanel>
                    </Border>

                    <!-- Application Status Card -->
                    <Border Style="{StaticResource CardStandard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="PLATFORM ENVIRONMENT STATUS"
                                       Style="{StaticResource TextCaption}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Engine:" Style="{StaticResource TextCaption}" Margin="0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ApplicationStatus.EngineVersion, TargetNullValue='v1.0.0-rc2'}" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,3"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Framework:" Style="{StaticResource TextCaption}" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text=".NET 10.0 LTS (WPF)" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,3"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Data Tier:" Style="{StaticResource TextCaption}" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ApplicationStatus.DatabaseStatus, TargetNullValue='In-Memory Audit Tier'}" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,3"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Station Profile:" Style="{StaticResource TextCaption}" Margin="0,3"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Offline Technician Lab" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,3"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Latest Application Events Card -->
                    <Border Style="{StaticResource CardStandard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DIAGNOSTIC EVENT LOG"
                                           Style="{StaticResource TextCaption}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextMuted}"/>
                                <Button Grid.Column="1"
                                        Content="View Full Console"
                                        Command="{Binding NavigateToCommand}"
                                        CommandParameter="console"
                                        Style="{StaticResource ButtonSecondary}"
                                        Height="22"
                                        Padding="6,0"
                                        FontSize="10"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding LatestEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushSurfaceElevated}"
                                                BorderBrush="{DynamicResource BrushSurfaceBorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusSmall}"
                                                Padding="8,5"
                                                Margin="0,0,0,4">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                                               Style="{StaticResource TextMonospace}"
                                                               Foreground="{DynamicResource BrushAccent}"
                                                               FontSize="10"
                                                               Margin="0,0,6,0"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Source, StringFormat='[{0}]'}"
                                                               Style="{StaticResource TextMonospace}"
                                                               Foreground="{DynamicResource BrushTextMuted}"
                                                               FontSize="10"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Message}"
                                                           Style="{StaticResource TextMonospace}"
                                                           Foreground="{DynamicResource BrushTextSecondary}"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
