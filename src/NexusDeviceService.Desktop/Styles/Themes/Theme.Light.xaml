<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Workspace & Surface Colors (Light Slate / Clean Laboratory Workspace) -->
    <Color x:Key="ColorWorkspaceBackground">#F1F5F9</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceElevated">#F8FAFC</Color>
    <Color x:Key="ColorSurfaceBorder">#CBD5E1</Color>
    <Color x:Key="ColorSurfaceBorderSubtle">#E2E8F0</Color>

    <!-- Restrained Blue Accents -->
    <Color x:Key="ColorAccent">#2563EB</Color>
    <Color x:Key="ColorAccentHover">#1D4ED8</Color>
    <Color x:Key="ColorAccentPressed">#1E40AF</Color>
    <Color x:Key="ColorAccentSubtle">#EFF6FF</Color>
    <Color x:Key="ColorAccentText">#FFFFFF</Color>

    <!-- High-Contrast Text Colors -->
    <Color x:Key="ColorTextPrimary">#0F172A</Color>
    <Color x:Key="ColorTextSecondary">#334155</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>
    <Color x:Key="ColorTextDisabled">#94A3B8</Color>

    <!-- Semantic Status Colors -->
    <Color x:Key="ColorStatusSuccess">#059669</Color>
    <Color x:Key="ColorStatusSuccessBg">#D1FAE5</Color>
    <Color x:Key="ColorStatusWarning">#D97706</Color>
    <Color x:Key="ColorStatusWarningBg">#FEF3C7</Color>
    <Color x:Key="ColorStatusError">#DC2626</Color>
    <Color x:Key="ColorStatusErrorBg">#FEE2E2</Color>
    <Color x:Key="ColorStatusInfo">#0284C7</Color>
    <Color x:Key="ColorStatusInfoBg">#E0F2FE</Color>
    <Color x:Key="ColorStatusSimulation">#D97706</Color>
    <Color x:Key="ColorStatusSimulationBg">#FEF3C7</Color>

    <!-- Form Inputs & Controls -->
    <Color x:Key="ColorInputBackground">#FFFFFF</Color>
    <Color x:Key="ColorInputBorder">#CBD5E1</Color>
    <Color x:Key="ColorInputBorderFocus">#2563EB</Color>
    <Color x:Key="ColorInputDisabledBg">#F1F5F9</Color>

    <!-- DataGrid & Lists -->
    <Color x:Key="ColorDataGridHeaderBg">#E2E8F0</Color>
    <Color x:Key="ColorDataGridRowAlternateBg">#F8FAFC</Color>
    <Color x:Key="ColorDataGridRowHoverBg">#EDF2F7</Color>
    <Color x:Key="ColorDataGridRowSelectedBg">#DBEAFE</Color>
    <Color x:Key="ColorDataGridRowSelectedText">#1E3A8A</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="BrushWorkspaceBackground" Color="{StaticResource ColorWorkspaceBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceElevated" Color="{StaticResource ColorSurfaceElevated}" />
    <SolidColorBrush x:Key="BrushSurfaceBorder" Color="{StaticResource ColorSurfaceBorder}" />
    <SolidColorBrush x:Key="BrushSurfaceBorderSubtle" Color="{StaticResource ColorSurfaceBorderSubtle}" />

    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="BrushAccentPressed" Color="{StaticResource ColorAccentPressed}" />
    <SolidColorBrush x:Key="BrushAccentSubtle" Color="{StaticResource ColorAccentSubtle}" />
    <SolidColorBrush x:Key="BrushAccentText" Color="{StaticResource ColorAccentText}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushTextDisabled" Color="{StaticResource ColorTextDisabled}" />

    <SolidColorBrush x:Key="BrushStatusSuccess" Color="{StaticResource ColorStatusSuccess}" />
    <SolidColorBrush x:Key="BrushStatusSuccessBg" Color="{StaticResource ColorStatusSuccessBg}" />
    <SolidColorBrush x:Key="BrushStatusWarning" Color="{StaticResource ColorStatusWarning}" />
    <SolidColorBrush x:Key="BrushStatusWarningBg" Color="{StaticResource ColorStatusWarningBg}" />
    <SolidColorBrush x:Key="BrushStatusError" Color="{StaticResource ColorStatusError}" />
    <SolidColorBrush x:Key="BrushStatusErrorBg" Color="{StaticResource ColorStatusErrorBg}" />
    <SolidColorBrush x:Key="BrushStatusInfo" Color="{StaticResource ColorStatusInfo}" />
    <SolidColorBrush x:Key="BrushStatusInfoBg" Color="{StaticResource ColorStatusInfoBg}" />
    <SolidColorBrush x:Key="BrushStatusSimulation" Color="{StaticResource ColorStatusSimulation}" />
    <SolidColorBrush x:Key="BrushStatusSimulationBg" Color="{StaticResource ColorStatusSimulationBg}" />

    <SolidColorBrush x:Key="BrushInputBackground" Color="{StaticResource ColorInputBackground}" />
    <SolidColorBrush x:Key="BrushInputBorder" Color="{StaticResource ColorInputBorder}" />
    <SolidColorBrush x:Key="BrushInputBorderFocus" Color="{StaticResource ColorInputBorderFocus}" />
    <SolidColorBrush x:Key="BrushInputDisabledBg" Color="{StaticResource ColorInputDisabledBg}" />

    <SolidColorBrush x:Key="BrushDataGridHeaderBg" Color="{StaticResource ColorDataGridHeaderBg}" />
    <SolidColorBrush x:Key="BrushDataGridRowAlternateBg" Color="{StaticResource ColorDataGridRowAlternateBg}" />
    <SolidColorBrush x:Key="BrushDataGridRowHoverBg" Color="{StaticResource ColorDataGridRowHoverBg}" />
    <SolidColorBrush x:Key="BrushDataGridRowSelectedBg" Color="{StaticResource ColorDataGridRowSelectedBg}" />
    <SolidColorBrush x:Key="BrushDataGridRowSelectedText" Color="{StaticResource ColorDataGridRowSelectedText}" />

    <!-- Button Brushes -->
    <SolidColorBrush x:Key="BrushButtonSecondaryBg" Color="#F1F5F9" />
    <SolidColorBrush x:Key="BrushButtonSecondaryBorder" Color="#CBD5E1" />
    <SolidColorBrush x:Key="BrushButtonSecondaryHover" Color="#E2E8F0" />

</ResourceDictionary>
