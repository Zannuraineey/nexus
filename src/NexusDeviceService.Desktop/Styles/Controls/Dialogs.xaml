<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Modal Backdrop -->
    <Style x:Key="ModalBackdrop" TargetType="Border">
        <Setter Property="Background" Value="#99000000" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- Dialog Surface Card -->
    <Style x:Key="DialogSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushSurfaceBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="MinWidth" Value="380" />
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Confirmation Banner -->
    <Style x:Key="ConfirmationBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushStatusWarningBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusWarning}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

</ResourceDictionary>
