<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Badge Style (Targeting Border) -->
    <Style x:Key="BadgeBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="{StaticResource PaddingBadge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextBlock.FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="TextBlock.FontWeight" Value="SemiBold" />
    </Style>

    <!-- Success Badge -->
    <Style x:Key="BadgeSuccess" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource BrushStatusSuccessBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusSuccess}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushStatusSuccess}" />
    </Style>

    <!-- Warning Badge -->
    <Style x:Key="BadgeWarning" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource BrushStatusWarningBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusWarning}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushStatusWarning}" />
    </Style>

    <!-- Error Badge -->
    <Style x:Key="BadgeError" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource BrushStatusErrorBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusError}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushStatusError}" />
    </Style>

    <!-- Info / Accent Badge -->
    <Style x:Key="BadgeInfo" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource BrushStatusInfoBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusInfo}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushStatusInfo}" />
    </Style>

    <!-- Simulation Mode Indicator Badge -->
    <Style x:Key="BadgeSimulation" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource BrushStatusSimulationBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusSimulation}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushStatusSimulation}" />
    </Style>

    <!-- Neutral Badge -->
    <Style x:Key="BadgeNeutral" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushSurfaceBorder}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushTextMuted}" />
    </Style>

    <!-- Standard Badge (alias for neutral/standard badge) -->
    <Style x:Key="BadgeStandard" TargetType="Border" BasedOn="{StaticResource BadgeNeutral}" />

</ResourceDictionary>
