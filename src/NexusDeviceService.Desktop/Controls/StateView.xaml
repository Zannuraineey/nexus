<UserControl x:Class="NexusDeviceService.Desktop.Controls.StateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="400">

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushSurfaceBorderSubtle}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Padding="28"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
            <!-- State Icon -->
            <Border Width="44" Height="44"
                    CornerRadius="22"
                    Background="{DynamicResource BrushSurfaceElevated}"
                    BorderBrush="{DynamicResource BrushSurfaceBorder}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14">
                <Path x:Name="iconPath"
                      Data="{Binding IconGeometry, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Fill="{Binding IconBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Width="20" Height="20"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>

            <!-- Title -->
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="{StaticResource FontSizeSection}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,6" />

            <!-- Description -->
            <TextBlock Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="{StaticResource FontSizeCompact}"
                       Foreground="{DynamicResource BrushTextMuted}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <!-- Optional Action Button -->
            <Button x:Name="actionBtn"
                    Content="{Binding ActionText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Command="{Binding ActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding ActionCommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
