<Window x:Class="NexusDeviceService.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NexusDeviceService.Desktop.ViewModels"
        xmlns:conv="clr-namespace:NexusDeviceService.Desktop.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Icon="Assets/app.ico"
        Height="780" Width="1220"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource BrushWorkspaceBackground}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{StaticResource FontFamilyDefault}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:NavigationTargetToBooleanConverter x:Key="NavConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Top Title & Control Bar -->
            <RowDefinition Height="Auto" />
            <!-- 2. Main Shell Workspace (Sidebar + ContentHost) -->
            <RowDefinition Height="*" />
            <!-- 3. Collapsible Bottom Activity Console -->
            <RowDefinition Height="Auto" />
            <!-- 4. Bottom Connection/Status Strip -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Title Bar Area (Draggable Window Header) -->
        <Border Grid.Row="0"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushSurfaceBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,0,0,0"
                Height="46"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Brand & Product Name -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <!-- Right Actions & User Placeholder -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Product Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Background="{DynamicResource BrushSurfaceElevated}"
                            BorderBrush="{DynamicResource BrushAccent}"
                            BorderThickness="1.5"
                            Margin="0,0,12,0">
                        <Path Data="{StaticResource GeometryChip}"
                              Fill="{DynamicResource BrushAccent}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NEXUS"
                                       Style="{StaticResource TextSectionTitle}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushAccent}" />
                            <TextBlock Text=" DEVICE SERVICE"
                                       Style="{StaticResource TextSectionTitle}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Version}"
                                   Style="{StaticResource TextCaption}" />
                    </StackPanel>
                </StackPanel>

                <!-- Right Header Actions: Theme Toggle, Simulation Pill, Account, Caption Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <!-- Live Theme Toggle Button -->
                    <Button Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            Height="30"
                            Padding="10,0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Toggle between Dark and Light themes">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeometryThemeSun}"
                                  Fill="{DynamicResource BrushTextSecondary}"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ThemeButtonLabel}"
                                       FontSize="{StaticResource FontSizeCompact}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Simulation / Hardware Mode Indicator Badge -->
                    <Border Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource BadgeSimulation}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSimulationMode}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource BrushStatusSuccessBg}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusSuccess}" />
                                        <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushStatusSuccess}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource BrushStatusSimulation}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSimulationMode}" Value="False">
                                                <Setter Property="Fill" Value="{DynamicResource BrushStatusSuccess}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ModeBadgeText}" />
                        </StackPanel>
                    </Border>

                    <!-- User / Account Badge -->
                    <Border Background="{DynamicResource BrushSurfaceElevated}"
                            BorderBrush="{DynamicResource BrushSurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            ToolTip="Licensed Workstation Session">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="22" Height="22"
                                    CornerRadius="11"
                                    Background="{DynamicResource BrushAccentSubtle}"
                                    BorderBrush="{DynamicResource BrushAccent}"
                                    BorderThickness="1"
                                    Margin="0,0,6,0">
                                <TextBlock Text="TC"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding TechnicianName}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="{Binding AccountRole}"
                                           FontSize="9"
                                           Foreground="{DynamicResource BrushStatusSuccess}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Window Controls Divider -->
                    <Rectangle Width="1" Height="20"
                               Fill="{DynamicResource BrushSurfaceBorder}"
                               Margin="14,0,4,0"
                               VerticalAlignment="Center" />

                    <!-- Window Management Caption Buttons (Minimize, Maximize/Restore, Close) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Minimize Button -->
                        <Button x:Name="BtnMinimize"
                                Click="OnMinimizeClick"
                                Style="{StaticResource WindowCaptionButtonStyle}"
                                ToolTip="Minimize"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="M 0,0 L 10,0"
                                  Stroke="{DynamicResource BrushTextPrimary}"
                                  StrokeThickness="1.2"
                                  Width="10" Height="2"
                                  SnapsToDevicePixels="True"
                                  VerticalAlignment="Center" />
                        </Button>

                        <!-- Maximize / Restore Button -->
                        <Button x:Name="BtnMaximizeRestore"
                                Click="OnMaximizeRestoreClick"
                                Style="{StaticResource WindowCaptionButtonStyle}"
                                ToolTip="Maximize"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path x:Name="MaximizeIcon"
                                  Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                                  Stroke="{DynamicResource BrushTextPrimary}"
                                  StrokeThickness="1.2"
                                  Width="10" Height="10"
                                  SnapsToDevicePixels="True"
                                  VerticalAlignment="Center" />
                        </Button>

                        <!-- Close Button -->
                        <Button x:Name="BtnClose"
                                Click="OnCloseClick"
                                Style="{StaticResource WindowCloseButtonStyle}"
                                ToolTip="Close"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Width="10" Height="10"
                                  SnapsToDevicePixels="True"
                                  VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>


        <!-- Main Shell Body: Left Sidebar + Content Host -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Navigation Sidebar -->
                <ColumnDefinition Width="230" />
                <!-- Content Host -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushSurfaceBorder}"
                    BorderThickness="0,0,1,0"
                    Padding="12,16">
                <DockPanel LastChildFill="True">
                    <!-- Sidebar Footer: Host & Diagnostic Notice -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{DynamicResource BrushSurfaceElevated}"
                            BorderBrush="{DynamicResource BrushSurfaceBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Padding="10"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Local Workstation" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding MachineName}" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Text=".NET 10 LTS x64" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushStatusSuccess}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Navigation Items List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="NAVIGATION"
                                       Style="{StaticResource TextCaption}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       Margin="10,0,0,10" />

                            <!-- 1. Dashboard -->
                            <RadioButton Style="{StaticResource NavItemButton}"
                                         IsChecked="{Binding ActiveTarget, Mode=OneWay, Converter={StaticResource NavConverter}, ConverterParameter=Dashboard}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Dashboard">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeometryDashboard}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 2. Devices -->
                            <RadioButton Style="{StaticResource NavItemButton}"
                                         IsChecked="{Binding ActiveTarget, Mode=OneWay, Converter={StaticResource NavConverter}, ConverterParameter=Devices}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Devices">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeometryDevices}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Devices" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 3. Operations -->
                            <RadioButton Style="{StaticResource NavItemButton}"
                                         IsChecked="{Binding ActiveTarget, Mode=OneWay, Converter={StaticResource NavConverter}, ConverterParameter=Operations}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Operations">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeometryOperations}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Operations" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 4. Firmware -->
                            <RadioButton Style="{StaticResource NavItemButton}"
                                         IsChecked="{Binding ActiveTarget, Mode=OneWay, Converter={StaticResource NavConverter}, ConverterParameter=Firmware}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Firmware">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeometryFirmware}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Firmware" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 5. Console -->
                            <RadioButton Style="{StaticResource NavItemButton}"
                                         IsChecked="{Binding ActiveTarget, Mode=OneWay, Converter={StaticResource NavConverter}, ConverterParameter=Console}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Console">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeometryTerminal}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Console" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 6. History -->
                            <RadioButton Style="{StaticResource NavItemButton}"
                                         IsChecked="{Binding ActiveTarget, Mode=OneWay, Converter={StaticResource NavConverter}, ConverterParameter=History}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="History">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeometryHistory}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="History" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 7. Settings -->
                            <RadioButton Style="{StaticResource NavItemButton}"
                                         IsChecked="{Binding ActiveTarget, Mode=OneWay, Converter={StaticResource NavConverter}, ConverterParameter=Settings}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Settings">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeometrySettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 8. About -->
                            <RadioButton Style="{StaticResource NavItemButton}"
                                         IsChecked="{Binding ActiveTarget, Mode=OneWay, Converter={StaticResource NavConverter}, ConverterParameter=About}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="About">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeometryInfo}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="About" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Main Content Host: Preserves Shell Architecture -->
            <Border Grid.Column="1" Background="{DynamicResource BrushWorkspaceBackground}">
                <ContentControl Content="{Binding CurrentPageViewModel}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>
        </Grid>

        <!-- Collapsible Bottom Activity Console -->
        <Border Grid.Row="2"
                Visibility="{Binding IsConsoleExpanded, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushSurfaceBorder}"
                BorderThickness="0,1,0,0"
                Height="150"
                Padding="16,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Mini Console Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVITY STREAM (RECENT)" Style="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Clear" Command="{Binding ClearBottomConsoleCommand}" Style="{StaticResource ButtonSecondary}" Height="24" Padding="8,2" Margin="0,0,6,0"/>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Console" Style="{StaticResource ButtonSecondary}" Height="24" Padding="8,2">
                            <TextBlock Text="Open Full Console" Style="{StaticResource TextCaption}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Recent Logs List -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding BottomConsoleLogs}"
                         Background="{DynamicResource BrushInputBackground}"
                         BorderBrush="{DynamicResource BrushSurfaceBorderSubtle}"
                         BorderThickness="1"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss}]'}" Style="{StaticResource TextMonospace}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Level, StringFormat='[{0}]'}" Style="{StaticResource TextMonospace}" Foreground="{DynamicResource BrushAccent}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Message}" Style="{StaticResource TextMonospace}" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Bottom Connection / Status Strip -->
        <Border Grid.Row="3"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushSurfaceBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Status message -->
                    <ColumnDefinition Width="*" />
                    <!-- Connection & Telemetry info -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeometryTerminal}"
                          Fill="{DynamicResource BrushAccent}"
                          Width="12" Height="12"
                          Stretch="Uniform"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource TextCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Toggle Console Button -->
                    <Button Command="{Binding ToggleConsoleCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            Height="24"
                            Padding="8,2"
                            Margin="0,0,14,0"
                            ToolTip="Toggle collapsible bottom activity console">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeometryTerminal}"
                                  Fill="{DynamicResource BrushTextSecondary}"
                                  Width="11" Height="11"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Activity Console" Style="{StaticResource TextCaption}"/>
                        </StackPanel>
                    </Button>

                    <!-- Connection Status Indicator -->
                    <Border Background="{DynamicResource BrushSurfaceElevated}"
                            BorderBrush="{DynamicResource BrushSurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="8,2"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushStatusSimulation}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource TextCaption}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Architecture status -->
                    <TextBlock Text="Shell Engine: v1.0.0"
                               Style="{StaticResource TextCaption}"
                               Foreground="{DynamicResource BrushTextMuted}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
